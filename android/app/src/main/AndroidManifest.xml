<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The crossword's optional AI editor calls the OpenAI API with the
         user's own key. Debug and profile builds get this permission from
         their own manifests; without it here a release build fails every
         call with "no connection to host". Everything else is offline. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Daily word-reminder notifications. They fire at random times of
         day, so they are scheduled inexactly: Play policy reserves exact
         alarms for alarm-clock and calendar apps, and a reminder that lands
         within a few minutes of its slot is no worse. BOOT_COMPLETED lets
         the plugin's receiver re-register pending reminders after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="Lexery"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Deep links are handled by supabase_flutter (app_links), not
                 by the router: the sign-in link must complete the session
                 without navigating anywhere. Left on, Flutter also hands
                 the URL to go_router, which has no such route. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Sign-in links from the account email open the app
                 (lexery://auth); supabase_flutter completes the session. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="lexery" android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- The receiver that actually fires a scheduled notification when
             its alarm goes off. Without this declared, AlarmManager still
             "delivers" the broadcast (it counts as a wakeup) but Android has
             no registered component to hand it to, so notifications never
             appear — silently, with no error anywhere. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Lets flutter_local_notifications re-arm exact alarms after a
             reboot; the app itself also re-schedules on every launch, so
             this only matters if the device restarts while unopened. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets flutter_tts find the device's installed TTS engines on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
