// Landing page for Word Wizard, served as a Cloudflare Worker with static assets.
// Deploy: `npx wrangler deploy` from this directory (needs `npx wrangler login` once).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordwizard-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "wordwizard.wcgill.com", "custom_domain": true }
  ]
}
