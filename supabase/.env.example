# Function secrets. Copy to supabase/.env for `supabase start` (never
# committed), and set on a hosted project with:
#   supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the platform automatically; do not set them here.

# The one OpenAI key. Lives only here — never in the app.
OPENAI_API_KEY=sk-...

# RevenueCat → Project settings → API keys → secret key (starts with sk_).
REVENUECAT_API_KEY=sk_...
# Anything long and random; paste the same value into RevenueCat's webhook
# "Authorization header value" as "Bearer <value>".
REVENUECAT_WEBHOOK_SECRET=

# Local-only auth providers (hosted projects configure these in the dashboard).
APPLE_CLIENT_ID=
APPLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
