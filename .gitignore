# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Content pipeline — raw downloads and large intermediate output are not committed
tool/pipeline/raw/
tool/pipeline/out/dictionary-full.db

# Generated code
**/*.g.dart
**/*.freezed.dart
**/*.drift.dart

# Local Gradle home used by the Android build — huge, machine-local cache
/.gradle-home/

# The bundled dictionary is a ~400 MB build artifact, not source: it is
# generated by tool/pipeline/build_dictionary.py from a Kaikki.org Wiktionary
# dump. GitHub rejects any file over 100 MB, and it was purged from this
# repo's history for that reason. See the README for how to rebuild it.
assets/db/dictionary.db
tool/pipeline/raw/
tool/pipeline/out/dictionary-full.db

# Secrets. The crossword's editorial pass reads OPENAI_API_KEY from here, and
# .env is bundled as an asset in debug builds, so it must never be committed.
# `.env.example` is the committed template.
.env

# Claude Code scratch: worktrees are full checkouts of this repo, and the
# local settings file is per-machine.
.claude/worktrees/
.claude/settings.local.json

# A 229 MB source snapshot dropped in the repo root — far over GitHub's
# 100 MB file limit, and everything in it is already tracked here.
/WordWizardSource.zip

# Supabase local secrets and state
supabase/.env
supabase/.branches
supabase/.temp

# Crossword harness runs (tool/crossword_harness.dart)
tool/crossword_harness/out/

# Signing keys never go in git (android/key.properties points at them)
*.jks
*.keystore

# Wrangler's local cache (account details)
site/.wrangler/

# Clue bake caches and batch files (the result lives in assets/crossword/wordlist.tsv)
tool/pipeline/out/clue_bake/
